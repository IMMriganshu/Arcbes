---
import SectionLabel from "./SectionLabel.astro";
import { portfolioProjects } from "../data/siteData";
---

<section class="recent-works" id="portfolio">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 pt-12 md:pt-16 pb-4">
    <div class="recent-works__badge">
      <SectionLabel text="OUR PORTFOLIO" />
    </div>
  </div>

  <div class="recent-works__wrapper" data-recent-works>
    <div class="recent-works__sticky">
      <!-- Title text layer -->
      <div class="recent-works__title-area" data-rw-titles>
        <div class="recent-works__line-one">
          <h2 class="recent-works__title">Recent</h2>
        </div>
        <div class="recent-works__line-two">
          <h2 class="recent-works__title recent-works__title--tablet">Works</h2>
          <div class="recent-works__text-left" data-rw-left>
            <h2 class="recent-works__title">Wo</h2>
          </div>
          <div class="recent-works__text-right" data-rw-right>
            <h2 class="recent-works__title">rks</h2>
          </div>
        </div>
      </div>

      <!-- Projects area layer (Appears inside "Recent Works" and expands on scroll) -->
      <div class="recent-works__projects-area" data-rw-projects>
        {portfolioProjects.map((project, idx) => (
          <div
            class="recent-works__project-item"
            data-rw-item={idx}
            style={`z-index: ${idx + 1};`}
          >
            <a href="/projects" class="recent-works__project-image-link">
              <img
                src={project.image}
                alt={project.title}
                loading="eager"
                decoding="async"
                class="recent-works__project-image"
              />
            </a>
            <div class="recent-works__project-meta">
              <span class="recent-works__project-number" aria-hidden="true">
                {project.number}
              </span>
              <a href="/projects" class="recent-works__project-name">
                {project.title}
                <div class="recent-works__project-name-border"></div>
              </a>
              <a href="/projects" class="recent-works__project-category">
                {project.category}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .recent-works {
    position: relative;
    background-color: var(--bg-page, #FCFCFC);
  }

  .recent-works__badge {
    margin-bottom: 24px;
  }

  .recent-works__wrapper {
    min-height: 350vh;
    position: relative;
  }

  .recent-works__sticky {
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    display: flex;
    position: sticky;
    top: 0;
    overflow: hidden;
  }

  .recent-works__title-area {
    text-align: center;
    width: 100%;
    opacity: var(--rw-titles-opacity, 1);
    transition: opacity 0.1s linear;
    user-select: none;
    pointer-events: none;
  }

  .recent-works__title {
    text-align: center;
    margin: 0;
    font-size: 200px;
    font-weight: 700;
    line-height: 1;
    font-family: 'Urbanist', sans-serif;
    letter-spacing: -0.04em;
    color: var(--text-primary, #030303);
  }

  .recent-works__title--tablet {
    display: none;
  }

  .recent-works__line-two {
    justify-content: center;
    align-items: center;
    gap: 200px;
    display: flex;
  }

  .recent-works__text-left,
  .recent-works__text-right {
    flex-shrink: 0;
    overflow: hidden;
  }

  .recent-works__text-left {
    transform: translateX(var(--rw-left-tx, 25%));
  }

  .recent-works__text-right {
    transform: translateX(var(--rw-right-tx, -25%));
  }

  .recent-works__projects-area {
    width: var(--rw-area-width, 20%);
    opacity: var(--rw-area-opacity, 0);
    z-index: 5;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 1320px;
  }

  .recent-works__project-item {
    width: 100%;
    opacity: var(--rw-item-opacity, 0);
    transform: translateY(var(--rw-item-ty, -30px));
    background-color: var(--bg-page, #FCFCFC);
    position: absolute;
    top: 0;
    left: 0;
  }

  .recent-works__project-item:first-child {
    opacity: var(--rw-item-opacity, 1);
    transform: translateY(var(--rw-item-ty, 0px));
    position: relative;
  }

  .recent-works__project-image-link {
    border-radius: 24px;
    display: block;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.12);
  }

  .recent-works__project-image {
    aspect-ratio: 2.2;
    object-fit: cover;
    width: 100%;
    display: block;
  }

  .recent-works__project-meta {
    border-top: none;
    align-items: center;
    gap: 20px;
    padding-top: 20px;
    font-size: 20px;
    font-weight: 500;
    display: flex;
  }

  .recent-works__project-number {
    letter-spacing: 0.1em;
    color: var(--accent-gold, #C5A880);
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    font-family: monospace;
  }

  .recent-works__project-name {
    color: inherit;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    display: inline-flex;
    font-size: 20px;
    font-weight: 600;
  }

  .recent-works__project-name-border {
    transform-origin: 0;
    width: 100%;
    height: 1px;
    transition: transform 0.25s ease;
    background-color: currentColor;
    margin-top: 3px;
    transform: scaleX(0);
  }

  .recent-works__project-name:hover .recent-works__project-name-border {
    transform: scaleX(1);
  }

  .recent-works__project-category {
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.55;
    transition: color 0.2s, opacity 0.2s;
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .recent-works__project-category:hover {
    color: var(--accent-gold, #C5A880);
    opacity: 1;
  }

  @media screen and (min-width: 1280px) {
    .recent-works__title {
      font-size: 275px;
    }
  }

  @media screen and (min-width: 1440px) {
    .recent-works__title {
      font-size: 350px;
    }
    .recent-works__line-two {
      gap: 345px;
    }
  }

  @media screen and (max-width: 991px) {
    .recent-works {
      padding: 80px 0;
    }
    .recent-works__wrapper {
      min-height: auto;
    }
    .recent-works__sticky {
      min-height: auto;
      display: block;
      position: static;
      overflow: visible;
    }
    .recent-works__title {
      font-size: 140px;
    }
    .recent-works__title-area {
      opacity: 1 !important;
    }
    .recent-works__title--tablet {
      display: block;
    }
    .recent-works__text-left,
    .recent-works__text-right {
      display: none;
    }
    .recent-works__line-two {
      flex-direction: column;
      gap: 0;
    }
    .recent-works__projects-area {
      flex-direction: column;
      gap: 40px;
      margin-top: 50px;
      display: flex;
      position: static;
      transform: none;
      opacity: 1 !important;
      width: 100% !important;
    }
    .recent-works__project-item,
    .recent-works__project-item:first-child {
      position: static;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  @media screen and (max-width: 767px) {
    .recent-works {
      padding: 60px 0;
    }
    .recent-works__title {
      font-size: 22vw;
    }
    .recent-works__project-image {
      aspect-ratio: 16/10;
    }
    .recent-works__project-meta {
      gap: 14px;
      font-size: 16px;
    }
  }
</style>

<script>
  function initRecentWorksScroll() {
    const wrapper = document.querySelector<HTMLElement>('[data-recent-works]');
    if (!wrapper) return;

    if (window.matchMedia('(min-width: 992px)').matches) {
      const titles = wrapper.querySelector<HTMLElement>('[data-rw-titles]');
      const leftText = wrapper.querySelector<HTMLElement>('[data-rw-left]');
      const rightText = wrapper.querySelector<HTMLElement>('[data-rw-right]');
      const projectsArea = wrapper.querySelector<HTMLElement>('[data-rw-projects]');
      const items = wrapper.querySelectorAll<HTMLElement>('[data-rw-item]');
      let ticking = false;

      const clamp = (val: number) => Math.max(0, Math.min(1, val));

      const update = () => {
        const rect = wrapper.getBoundingClientRect();
        const totalScroll = wrapper.offsetHeight - window.innerHeight;
        if (totalScroll <= 0) return;

        const progress = clamp(-rect.top / totalScroll);

        // 1. Initial slit appears and letters push out (progress 0.0 -> 0.20)
        const d = clamp(progress / 0.2);
        if (leftText) leftText.style.setProperty('--rw-left-tx', `${25 * (1 - d)}%`);
        if (rightText) rightText.style.setProperty('--rw-right-tx', `${-25 * (1 - d)}%`);
        if (projectsArea) projectsArea.style.setProperty('--rw-area-opacity', String(d));

        // 2. Width expands from 20% to 100% (progress 0.15 -> 0.50)
        const f = clamp((progress - 0.15) / 0.35);
        if (projectsArea) projectsArea.style.setProperty('--rw-area-width', `${20 + 80 * f}%`);

        // 3. Titles fade out (progress 0.25 -> 0.45)
        const p = 1 - clamp((progress - 0.25) / 0.2);
        if (titles) titles.style.setProperty('--rw-titles-opacity', String(p));

        // 4. Slide transitions one by one (progress 0.50 -> 1.00)
        const m = items.length;
        items.forEach((item, idx) => {
          if (idx === 0) return;
          const n = 0.5 + (0.5 / (m - 1)) * (idx - 1);
          const r = clamp((progress - n) / 0.08);
          if (progress >= n) {
            item.style.setProperty('--rw-item-opacity', String(r));
            item.style.setProperty('--rw-item-ty', `${-30 * (1 - r)}px`);
          } else {
            item.style.setProperty('--rw-item-opacity', '0');
            item.style.setProperty('--rw-item-ty', '-30px');
          }
        });

        ticking = false;
      };

      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });

      window.addEventListener('resize', update, { passive: true });
      update();
    }
  }

  // Initialize on load and on Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRecentWorksScroll);
  } else {
    initRecentWorksScroll();
  }
</script>
